{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sesame.local/schemas/probability-model-proposal.schema.json",
  "title": "Probability Model Proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "experiment_id",
    "status",
    "models"
  ],
  "properties": {
    "experiment_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed"
      ]
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model_id",
          "target_med",
          "distribution_type",
          "parameters",
          "evidence_refs",
          "confidence"
        ],
        "properties": {
          "model_id": {
            "type": "string"
          },
          "target_med": {
            "type": "string"
          },
          "distribution_type": {
            "type": "string"
          },
          "parameters": {
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string"
                },
                {
                  "type": "boolean"
                }
              ]
            }
          },
          "heuristic_parameters": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
