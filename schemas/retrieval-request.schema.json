{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sesame.local/schemas/retrieval-request.schema.json",
  "title": "Retrieval Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "experiment_id",
    "objective",
    "target",
    "etherscan_request",
    "dune_request"
  ],
  "properties": {
    "experiment_id": {
      "type": "string"
    },
    "objective": {
      "type": "string"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chain",
        "contract_address",
        "contract_label"
      ],
      "properties": {
        "chain": {
          "type": "string"
        },
        "contract_address": {
          "type": "string"
        },
        "contract_label": {
          "type": "string"
        }
      }
    },
    "etherscan_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "template",
        "required_outputs"
      ],
      "properties": {
        "template": {
          "type": "string"
        },
        "required_outputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "dune_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "template",
        "analysis_window",
        "target_metrics"
      ],
      "properties": {
        "template": {
          "type": "string"
        },
        "analysis_window": {
          "type": "string"
        },
        "target_metrics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
