{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sesame.local/schemas/etherscan-mcp-capture.schema.json",
  "title": "Etherscan MCP Capture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "experiment_id",
    "contract",
    "functions",
    "events"
  ],
  "properties": {
    "experiment_id": {
      "type": "string"
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chain",
        "address",
        "label"
      ],
      "properties": {
        "chain": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      }
    },
    "functions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    }
  }
}
