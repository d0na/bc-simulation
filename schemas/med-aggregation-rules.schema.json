{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sesame.local/schemas/med-aggregation-rules.schema.json",
  "title": "MED Aggregation Rules",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "experiment_id",
    "rules"
  ],
  "properties": {
    "experiment_id": {
      "type": "string"
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "med_id",
          "label",
          "function_names",
          "event_names",
          "metric_names",
          "rationale_template"
        ],
        "properties": {
          "med_id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "function_names": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "event_names": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "metric_names": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "gas_strategy": {
            "type": "string",
            "enum": [
              "max_function_gas",
              "first_function_gas"
            ],
            "default": "max_function_gas"
          },
          "rationale_template": {
            "type": "string"
          }
        }
      }
    }
  }
}
