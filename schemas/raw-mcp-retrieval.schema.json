{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sesame.local/schemas/raw-mcp-retrieval.schema.json",
  "title": "Raw MCP Retrieval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "experiment_id",
    "contract",
    "etherscan",
    "dune"
  ],
  "properties": {
    "experiment_id": {
      "type": "string"
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chain",
        "address",
        "label"
      ],
      "properties": {
        "chain": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      }
    },
    "etherscan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "functions",
        "events"
      ],
      "properties": {
        "functions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "dune": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metrics"
      ],
      "properties": {
        "metrics": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    }
  }
}
