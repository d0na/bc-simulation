{
  "experiment_id": "dao-vote-costs-v1",
  "objective": "Estimate governance workflow costs and adoption trends for a DAO voting process.",
  "target": {
    "chain": "ethereum",
    "contract_address": "0x1234...abcd",
    "contract_label": "ExampleGovernor"
  },
  "etherscan_request": {
    "template": "prompts/etherscan/retrieve-contract-evidence.v1.md",
    "required_outputs": [
      "abi_or_interface_metadata",
      "simulation_relevant_functions",
      "simulation_relevant_events",
      "available_gas_or_cost_signals"
    ]
  },
  "dune_request": {
    "template": "prompts/dune/retrieve-adoption-trends.v1.md",
    "analysis_window": "last_180_days",
    "target_metrics": [
      "daily_proposals",
      "daily_votes",
      "active_voters"
    ]
  }
}
