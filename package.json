{
  "name": "sesame",
  "version": "1.0.0",
  "private": true,
  "description": "Root helper package for the Sesame repository",
  "keywords": [

  ],
  "author": "Francesco Donini",
  "license": "ISC",
  "scripts": {
    "dev": "run-p dev:api dev:web",
    "dev:all": "run-p dev:api dev:web dev:mcp",
    "dev:api": "cd apps/api && ./mvnw spring-boot:run",
    "dev:web": "cd apps/web && npm run dev",
    "dev:mcp": "cd mcp-server && ./mvnw spring-boot:run",
    "build:web": "cd apps/web && npm run build",
    "build:api": "cd apps/api && ./mvnw -DskipTests package",
    "build:mcp": "cd mcp-server && ./mvnw -DskipTests package",
    "test:api": "cd apps/api && ./mvnw test",
    "test:mcp": "cd mcp-server && ./mvnw test",
    "install:web": "cd apps/web && npm install",
    "prepare:retrieval-request": "node scripts/prepare-retrieval-request.js",
    "render:retrieval-prompts": "node scripts/render-retrieval-prompts.js",
    "validate:experiment": "node scripts/validate-experiment.js",
    "generate:simulation-input": "node scripts/generate-simulation-input.js",
    "update:run-manifest": "node scripts/update-run-manifest.js",
    "launch:experiment": "node scripts/launch-experiment.js"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
